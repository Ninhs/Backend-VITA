SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY


DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=YOUR_DIFY_API_KEY
DIFY_API_KEY_2=YOUR_DIFY_API_KEY_2

# Bảng và cột dùng để tìm hợp đồng
SUPABASE_CONTRACT_TABLE=contracts
SUPABASE_CONTRACT_ID_COLUMN=contract_id

# Các bảng liên quan được gom vào case_data gửi sang Dify.
# Nếu chưa có các bảng này, có thể để trống:
# SUPABASE_RELATED_TABLES=
SUPABASE_RELATED_TABLES=orders,invoices,cashflow_forecasts,alerts,bank_transactions,opc_profile
SUPABASE_GLOBAL_RELATED_TABLES=bank_transactions,opc_profile
SUPABASE_RELATED_TABLE_LIMIT=500

# Bảng lưu quyết định từ các nút trên frontend
SUPABASE_DECISION_TABLE=agent_decisions

# =============================
# DIFY WORKFLOW
# =============================

DIFY_TIMEOUT_SECONDS=120
DIFY_USER=opc-dashboard-user

# Tên biến tại node Start trong Dify
DIFY_CONTRACT_ID_INPUT=contract_id
DIFY_CASE_DATA_INPUT=case_data

# =============================
# FASTAPI / FRONTEND
# =============================
HOST=127.0.0.1
PORT=8000

# Đăng nhập dashboard (đổi giá trị mặc định trước khi deploy thật!)
VITA_LOGIN_USERNAME=admin
VITA_LOGIN_PASSWORD=doi-mat-khau-nay

# Cross-origin: domain GitHub Pages của frontend (không có dấu / cuối)
ALLOWED_ORIGINS=https://ninhs.github.io
COOKIE_SECURE=true
